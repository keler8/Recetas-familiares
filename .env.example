# ==========================================
# CONFIGURACIÓN RECETARIO FAMILIAR INTELIGENTE
# ==========================================

# Entorno y URLs
PROJECT_NAME="Recetario Familiar Inteligente"
ENVIRONMENT=production
HOST_PORT=8500
SERVER_IP=192.168.1.80
# Cuando configures Cloudflare / Nginx Proxy Manager, pon aquí la URL pública HTTPS:
EXTERNAL_URL=http://192.168.1.80:8500

# Seguridad de Aplicación (genera una cadena segura aleatoria)
SECRET_KEY=genera_una_clave_secreta_aleatoria_muy_larga_aqui
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Base de Datos PostgreSQL (Servicio interno Docker)
POSTGRES_USER=recetario_app
POSTGRES_PASSWORD=cambia_esta_password_segura_de_postgres
POSTGRES_DB=recetario_db

# Redis (Servicio interno Docker)
REDIS_URL=redis://redis:6379/0

# Rutas de almacenamiento interno
STORAGE_PATH=/app/data/storage
TEMP_PATH=/app/data/tmp
# Umbral mínimo de seguridad de espacio libre en disco (en GB) antes de pausar tareas pesadas:
DISK_MIN_FREE_GB=4

# Credenciales para el primer inicio de sesión del Administrador
INITIAL_ADMIN_EMAIL=admin@recetas.local
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=AdminRecetas_2026!

# Integración con Google Gemini (opcional al inicio, se puede configurar en panel de administración)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_ESTIMATED_MONTHLY_BUDGET=10.0

# Integración con Google Drive OAuth (opcional al inicio)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://192.168.1.80:8500/api/drive/callback

# Notificaciones por Correo SMTP (opcional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=recetas@familiar.local
SMTP_TLS=true

# Copia de seguridad secundaria Synology NAS (192.168.1.8 comprobada en red)
SYNOLOGY_HOST=192.168.1.8
SYNOLOGY_PORT=5000
SYNOLOGY_USER=
SYNOLOGY_PASSWORD=
SYNOLOGY_BACKUP_PATH=/volume1/Backups/Recetario
